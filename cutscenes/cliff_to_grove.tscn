beats = Array[String](["The passage goes down for longer than the mountain is tall.", "When it opens out again there are trees, and the trees are the wrong colour.", "The ground between them does not take a footprint. The light does not come from anywhere.", "Somewhere ahead of you, somebody is talking to nobody."])
title = "CASE 03"
subtitle = "THE CORRUPTED GROVE"
